<rule id="100105" level="12">

  <if_sid>61603</if_sid>

  <field name="win.eventdata.parentImage" type="pcre2">(?i)powershell\.exe</field>

  <field name="win.eventdata.image" type="pcre2">(?i)\\certutil\.exe$</field>

  <description>Custom Detection: PowerShell launched CERTUTIL.EXE</description>

  <mitre>
    <id>T1105</id>
  </mitre>

  <group>
    attack.execution,
    custom_detection,
  </group>

</rule>
