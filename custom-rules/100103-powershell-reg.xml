<rule id="100103" level="12">

  <if_group>sysmon_event1</if_group>

  <field name="win.eventdata.parentImage" type="pcre2">(?i)powershell\.exe</field>

  <field name="win.eventdata.image" type="pcre2">(?i)reg\.exe</field>

  <description>Custom Detection: PowerShell launched REG.EXE</description>

  <mitre>
    <id>T1112</id>
  </mitre>

</rule>
