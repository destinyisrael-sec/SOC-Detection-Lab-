<rule id="100109" level="13">

  <if_sid>61603</if_sid>

  <field name="win.eventdata.parentImage" type="pcre2">(?i)powershell\.exe</field>

  <field name="win.eventdata.image" type="pcre2">(?i)\\psexec.*\.exe$</field>

  <description>Custom Detection: PowerShell launched PsExec</description>

  <mitre>
    <id>T1021.002</id>
  </mitre>

  <group>
    attack.execution,
    lateral_movement,
    custom_detection,
  </group>

</rule>
