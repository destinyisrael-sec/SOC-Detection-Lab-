<rule id="100107" level="12">

  <if_sid>61603</if_sid>

  <field name="win.eventdata.parentImage" type="pcre2">(?i)powershell\.exe</field>

  <field name="win.eventdata.image" type="pcre2">(?i)\\rundll32\.exe$</field>

  <description>Custom Detection: PowerShell launched RUNDLL32.EXE</description>

  <mitre>
    <id>T1218.011</id>
  </mitre>

  <group>
    attack.execution,
    custom_detection,
  </group>

</rule>
