<rule id="100100" level="10">
  <if_group>sysmon_event1</if_group>
  <field name="win.eventdata.parentImage" type="pcre2">(?i)powershell\.exe</field>
  <field name="win.eventdata.image" type="pcre2">(?i)notepad\.exe</field>
  <description>Custom Detection: PowerShell launched Notepad</description>
  <mitre>
    <id>T1059.001</id>
  </mitre>
</rule>
